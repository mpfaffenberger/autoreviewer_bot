[Unit]
Description=autoreviewer GitHub webhook receiver (review.chaos-emerald.com)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/autoreviewer:latest
ContainerName=autoreviewer
# No published port: Caddy reaches it as autoreviewer:8000 on homelab-public.
Network=homelab-public.network
# App ID, slug, webhook secret (written by deploy/github-app/convert.sh).
EnvironmentFile=/home/bazzite/.config/homelab/autoreviewer-app.env
# AUTOREVIEWER_REPOS and other knobs.
EnvironmentFile=/home/bazzite/.config/homelab/autoreviewer.env
Volume=/home/bazzite/.config/homelab/autoreviewer-app.pem:/run/secrets/github-app.pem:ro,Z
Environment=AUTOREVIEWER_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# Checkouts for reviews: disk-backed (a tmpfs would count against the memory limit).
Volume=/home/bazzite/.local/share/autoreviewer:/var/lib/autoreviewer:Z
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
DropCapability=all
NoNewPrivileges=true
# uid 999 in the container is bazzite on the host, so the 0600 key stays readable without loosening it.
PodmanArgs=--userns=keep-id:uid=999,gid=999 --pids-limit=256 --memory=2g

[Service]
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
